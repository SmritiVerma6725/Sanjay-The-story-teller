*.py[cod]
*$py.class
*.so
.pytest_cache/
*.egg-info/
dist/
build/

# Virtual Environments
.venv/
venv/
env/
ENV/
signbridge-backend/.venv/
tools/isl_motion_extraction/.venv/

# External / Candidate Reference Repositories (Audited in Docs/ASSET_LICENSES.md)
GenASL/
kozha_repo/
yap_render_repo/

# Rights-Uncleared Media Assets (Mandatory per SignBridge Governance & PRD)
tools/isl_motion_extraction/reference_videos/*.mp4
tools/isl_motion_extraction/reference_videos/*.avi
tools/isl_motion_extraction/reference_videos/*.mov

# Machine Learning Binary Model Weights (Downloadable via download_models.py)
